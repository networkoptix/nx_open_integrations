# Shared configuration for the Nx API samples.
# Copy this file to ".env" and fill in your own values.
# Lines starting with "#" are comments and are ignored.

# The Nx Cloud host. For the public Network Optix cloud this is nxvms.com.
# Include the scheme (https://). Do NOT add a trailing slash.
NX_CLOUD_HOST=https://nxvms.com

# Your Nx Cloud account email (the address you log in to the cloud with).
NX_CLOUD_USER=you@example.com

# Your Nx Cloud account password.
NX_CLOUD_PASSWORD=your-password-here

# Optional. Some cloud deployments are "branded" and require a customization
# name (e.g. "default"). Leave blank unless your provider told you otherwise.
NX_CUSTOMIZATION=

# The Cloud Site ID (a UUID) of a specific site. Needed only to scope a token
# to one site, e.g. to list that site's cameras with a cloud account
# (used by python/rest-list-cameras-cloud-user). Find it in the Nx client.
NX_CLOUD_SITE_ID=


# ---------------------------------------------------------------------------
# VMS server (used by python/rest-list-cameras)
# ---------------------------------------------------------------------------
# A single VMS server/site. Include the scheme and port. Bearer auth needs HTTPS.
# Examples:  https://192.168.1.10:7001   or   https://<siteId>.relay.vmsproxy.com
NX_SERVER_HOST=https://192.168.1.10:7001

# A LOCAL server account (not a cloud user).
NX_SERVER_USER=admin
NX_SERVER_PASSWORD=your-server-password


# ---------------------------------------------------------------------------
# Media streaming (used by media-http-stream, all languages)
# ---------------------------------------------------------------------------
# Auth mode for the media sample: "direct" (to a server via NX_SERVER_*) or
# "cloud" (over the relay via NX_CLOUD_* + NX_CLOUD_SITE_ID). Default: direct.
NX_MODE=direct

# The camera/device id whose video to pull (the {id} in /rest/v4/devices/{id}).
NX_DEVICE_ID=

# Container format for the saved clip. One of the v4 enum values:
# webm, mpegts, mpjpeg, mp4, mkv, _3gp, rtp, flv, f4v. Default: webm.
NX_MEDIA_FORMAT=webm
