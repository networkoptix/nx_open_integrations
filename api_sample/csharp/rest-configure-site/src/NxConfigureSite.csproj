<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NxConfigureSite</RootNamespace>
    <AssemblyName>nx-configure-site</AssemblyName>
    <!-- No NuGet packages: HttpClient + System.Text.Json are in the framework. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The three site settings, copied next to the built program so the sample
         finds them from any directory. -->
    <None Include="site_settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
